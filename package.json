{
  "name": "anniversary",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "기념일 도감 - 세계 곳곳의 특이한 기념일과 이색 기념일을 모아 기록하는 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:slugs": "python3 tools/slugs/generate_slugs.py --check",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && npm run type-check:api",
    "type-check:api": "tsc -p api/tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"api/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\" \"tools/{og,prerender}/**/*.{ts,mjs}\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"api/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.ts\" \"tools/{og,prerender}/**/*.{ts,mjs}\" \"*.config.ts\"",
    "verify": "npm run format:check && npm run check:slugs && npm run build && npm run type-check:api && npm run test",
    "og:static": "node tools/og/run.mjs static",
    "og:samples": "node tools/og/run.mjs samples",
    "illus": "node tools/illustrations/illus.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/analytics": "^2.0.1",
    "botid": "^1.5.11",
    "dayjs": "^1.11.13",
    "html-to-image": "^1.11.13",
    "pinia": "^2.2.6",
    "satori": "^0.47.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "^2.1.10"
  }
}

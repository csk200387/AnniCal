{
  "name": "anniversary",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "기념일 만물상 - 기념일 큐레이션 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:slugs": "python3 tools/slugs/generate_slugs.py --check",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && npm run type-check:api",
    "type-check:api": "tsc -p api/tsconfig.json --noEmit",
    "verify": "npm run check:slugs && npm run build && npm run type-check:api && npm run test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dayjs": "^1.11.13",
    "html-to-image": "^1.11.13",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.1.10"
  }
}

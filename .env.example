# Vercel Marketplace의 Upstash for Redis를 연결하면 자동으로 주입됩니다.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-secret-token

# Upstash에서 직접 연결할 때는 아래 이름도 지원합니다.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-secret-token

# 비공개 저장소 하나에 Issues 쓰기 권한만 가진 GitHub App 인증정보입니다.
GITHUB_FEEDBACK_APP_ID=123456
GITHUB_FEEDBACK_INSTALLATION_ID=12345678
GITHUB_FEEDBACK_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_FEEDBACK_REPOSITORY=csk200387/AnniCal-feedback

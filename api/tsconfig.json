{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // 서버리스 함수만 진입점으로 둔다. 여기서 import 하는 src/ 파일은 따라가서
  // 함께 검사되지만, .vue 나 브라우저 전용 코드까지 끌어오지는 않는다.
  // 예전에는 "../src/**/*.ts" 를 통째로 include 하면서 alias 도 없어
  // TS2307 이 무더기로 나 단독 실행 자체가 불가능했다.
  "include": ["**/*.ts"]
}
